# Browser-safe project URL. The app does not expose database credentials to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase secret/service-role key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional server-only URL override. Leave unset to use NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# Optional test-only overrides. The defaults are suitable for local Playwright runs.
# PAIPA_E2E_BASE_URL=http://127.0.0.1:3000
# PAIPA_E2E_PORT=3000
